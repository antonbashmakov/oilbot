# next dev only (committed, synthetic values).
#
# Dev sign-in with ?tgUser=<id>: init data signed by the fake bot token of the test emulator
# (functions/.env.test-project). Production has no such token, so this data is refused there.
NEXT_PUBLIC_DEV_TELEGRAM_BOT_TOKEN=test-telegram-bot-token-123456
#
# Real Telegram login in a browser (TWA-02): set these in .env.development.local, not here.
#   NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<bot username, linked to the tunnel domain with /setdomain>
#   NEXT_PUBLIC_BASE_API_URL=            (empty: the app calls /api on the tunnel domain)
#   DEV_API_PROXY=http://127.0.0.1:5001/test-project/us-central1
#   DEV_TUNNEL_HOST=<tunnel host, for example abc.trycloudflare.com>
# and the same bot's real token as TELEGRAM_BOT_TOKEN in functions/.env.local (never committed).

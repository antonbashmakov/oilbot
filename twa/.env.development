# next dev only (committed, synthetic values). Lets the app sign in outside Telegram with init data
# signed by the fake bot token of the test emulator (functions/.env.test-project). Production has
# no such token, so this data is refused there. Try other customers with ?tgUser=<id>.
NEXT_PUBLIC_DEV_TELEGRAM_BOT_TOKEN=test-telegram-bot-token-123456
NEXT_PUBLIC_DEV_TELEGRAM_USER_ID=100000001

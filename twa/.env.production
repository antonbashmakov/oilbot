# Production build (committed, public values only). Empty base URL: the app calls /api/... on its
# own origin, which Firebase Hosting rewrites to the functions (firebase.json, target twa).
NEXT_PUBLIC_BASE_API_URL=
NEXT_PUBLIC_APP_URL=https://t.me/PoSebestoiosti_test_bot/app
# Telegram Login Widget in a web browser (TWA-02); the bot's domain is set with /setdomain.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=PoSebestoiosti_test_bot

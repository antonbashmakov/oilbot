{
  "name": "functions",
  "scripts": {
    "lint": "eslint --fix --ext .ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --inspect-functions",
    "serve:test": "tsc && firebase emulators:start --project test-project  --only \"firestore,functions\" --inspect-functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "openapi": "openapi-typescript resources/openapi/api.yml -o src/openapi/api.d.ts && openapi-typescript resources/openapi/models.yml -o src/openapi/models.d.ts",
    "logs": "firebase functions:log",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@types/mustache": "^4.2.6",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "momentjs": "^2.0.0",
    "mustache": "^4.2.0",
    "uuid": "^8"
  },
  "devDependencies": {
    "@firebase/testing": "^0.20.11",
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^9",
    "firebase-functions-test": "^3.1.0",
    "jest": "^30.2.0",
    "openapi-typescript": "^6.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "^4.9.0"
  },
  "private": true
}

{
  "name": "__SLUG__",
  "private": true,
  "scripts": {
    "emulators": "firebase emulators:start --project demo-__SLUG__ --only auth,firestore,functions",
    "dev": "npm --prefix functions run build && concurrently -k -n functions,emulators,ui \"npm --prefix functions run build:watch\" \"npm run emulators\" \"npm --prefix ui run dev\"",
    "seed": "npm --prefix functions run build && GCLOUD_PROJECT=demo-__SLUG__ FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node functions/lib/scripts/seed.js",
    "test": "npm --prefix functions run build && firebase emulators:exec --project demo-__SLUG__ --only auth,firestore,functions \"npm --prefix functions test\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "firebase-tools": "^15.34.2"
  }
}

// The emulators run the demo project "demo-<slug>" (rule 107.5); a deployed function never has a demo id.
export const EMULATOR_PROJECT_PREFIX = "demo-";

export const projectId = (): string => process.env.GCLOUD_PROJECT ?? process.env.GCP_PROJECT ?? "";

// Selects mock services for external systems in imports files (rule 106.8).
export const isEmulated = (): boolean => projectId().startsWith(EMULATOR_PROJECT_PREFIX);

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent-rules/scripts/check_setup.py\" --hint",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/agent-rules/scripts/spec_freshness.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}

{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "hosting": {
    "source": "crm",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/public/**",
        "function": "public",
        "region": "us-central1"
      },
      {
        "source": "/api/private/**",
        "function": "private"
      },
      {
        "source": "/api/admin/**",
        "function": "admin"
      },
      {
        "source": "/api/agent/**",
        "function": "agent"
      },
      {
        "source": "**",
        "function": "ssrposebestobusiness",
        "region": "europe-west1"
      }
    ],
    "frameworksBackend": {
      "region": "europe-west1"
    }
  }
}